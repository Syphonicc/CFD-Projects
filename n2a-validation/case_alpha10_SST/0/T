FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 288.15;

boundaryField
{
    inlet
    {
        type            inletOutlet;
        inletValue      uniform 288.15;
        value           uniform 288.15;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 288.15;
        value           uniform 288.15;
    }
    farfield
    {
        type            inletOutlet;
        inletValue      uniform 288.15;
        value           uniform 288.15;
    }
    symmetry
    {
        type            symmetry;
    }
    n2a
    {
        type            zeroGradient;      // adiabatic wall
    }
}

