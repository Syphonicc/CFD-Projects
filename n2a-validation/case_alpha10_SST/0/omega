FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

// TMR convention: omega_inf = 1e-6 * rho_inf * a_inf^2 / mu_inf
internalField   uniform 7.299513e+03;

boundaryField
{
    inlet
    {
        type            freestream;
        freestreamValue uniform 7.299513e+03;
    }
    outlet
    {
        type            freestream;
        freestreamValue uniform 7.299513e+03;
    }
    farfield
    {
        type            freestream;
        freestreamValue uniform 7.299513e+03;
    }
    symmetry
    {
        type            symmetry;
    }
    n2a
    {
        type            omegaWallFunction;
        value           uniform 7.299513e+03;
    }
}

