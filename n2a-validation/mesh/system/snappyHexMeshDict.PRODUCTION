/*--------------------------------*- C++ -*----------------------------------*\
| N2A Hybrid Wing-Body - WALL FUNCTION MESH                                     |
|                                                                               |
| Fallback from the wall-resolved requirement. Six attempts at y+ < 1 with a     |
| 12.5 micron first layer never exceeded 80% coverage and typically achieved     |
| only 1-3 of the requested layers; see notes/pilot_mesh_findings.md.            |
|                                                                               |
| Target here is y+ ~ 40, mid log-layer, where wall functions are valid.         |
|                                                                               |
|   y+ = 1  corresponds to 6.28 micron                                          |
|   y+ = 40 -> centroid at 251 micron -> first layer 0.5 mm                      |
|                                                                               |
|   10 layers, ratio 1.2, first 0.5 mm                                          |
|     total stack  12.98 mm                                                     |
|     last layer    2.58 mm                                                     |
|                                                                               |
| The first layer is 40x thicker than the wall-resolved attempt, which should    |
| put it well inside what medial-axis layer insertion can place.                 |
|                                                                               |
| Layer parameters carried from the pilot study:                                 |
|   nGrow 0                (nGrow 1 collapsed coverage to 0.05%)                 |
|   minMedialAxisAngle 130 (raised from 90: 73.9% -> 79.9%)                      |
|   maxThicknessToMedialRatio 0.6, nLayerIter 80, nRelaxedIter 50                |
|                                                                               |
| REMINDER: run blockMesh before every -overwrite run.                           |
\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    n2a_wt.stl
    {
        type triSurfaceMesh;
        name n2a;
    }

    refineNear
    {
        type searchableBox;
        min (-0.20 -0.05 -0.60);
        max ( 3.60  2.10  1.10);
    }

    refineWake
    {
        type searchableBox;
        min ( 2.40 -0.05 -0.55);
        max ( 8.00  2.10  0.95);
    }

    refineOuter
    {
        type searchableBox;
        min (-1.50 -0.10 -1.50);
        max (12.00  4.00  1.80);
    }
}

// ---------------------------------------------------------------------------
castellatedMeshControls
{
    maxLocalCells       20000000;
    maxGlobalCells      60000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features
    (
        { file "n2a_wt.eMesh"; level 10; }
    );

    refinementSurfaces
    {
        n2a
        {
            level (9 10);
            patchInfo { type wall; }

        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        refineNear  { mode inside; levels ((1E15 8)); }
        refineWake  { mode inside; levels ((1E15 7)); }
        refineOuter { mode inside; levels ((1E15 5)); }
    }

    locationInMesh (-20.137 15.211 8.309);

    allowFreeStandingZoneFaces true;
}

// ---------------------------------------------------------------------------
snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      50;
    nRelaxIter      5;

    nFeatureSnapIter        10;
    implicitFeatureSnap     false;
    explicitFeatureSnap     true;
    multiRegionFeatureSnap  false;
}

// ---------------------------------------------------------------------------
addLayersControls
{
    relativeSizes       false;      // absolute thicknesses, metres

    layers
    {
        "n2a.*"
        {
            nSurfaceLayers 25;
        }
    }

    firstLayerThickness 1.25e-5;
    expansionRatio      1.2;
    minThickness        1.25e-6;     // 10% of first layer

    // Alternate mesh shrinker: displacement motion solver instead of
    // the default medial axis algorithm (ESI OpenFOAM only)
    meshShrinker    displacementMotionSolver;
    solver          displacementLaplacian;
    displacementLaplacianCoeffs
    {
        diffusivity     quadratic inverseDistance 1(n2a);
    }

    nGrow               0;

    featureAngle        130;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.6;
    minMedialAxisAngle  130;
    nBufferCellsNoExtrude 0;
    nLayerIter          80;
    nRelaxedIter        50;
}

// ---------------------------------------------------------------------------
meshQualityControls
{
    maxNonOrtho         75;
    maxBoundarySkewness 2.5;
    maxInternalSkewness 2.5;
    maxConcave          85;
    minVol              1e-20;
    minTetQuality       -1e30;
    minArea             -1;
    minTwist            0.001;
    minDeterminant      1e-6;
    minFaceWeight       0.002;
    minVolRatio         0.001;
    minTriangleTwist    -1;

    nSmoothScale        4;
    errorReduction      0.75;

    relaxed
    {
        maxNonOrtho     85;
        minTwist        -1;
        minDeterminant  1e-9;
        minFaceWeight   1e-4;
        minVolRatio     1e-4;
    }
}

// ---------------------------------------------------------------------------
mergeTolerance 1e-6;

// ************************************************************************* //
