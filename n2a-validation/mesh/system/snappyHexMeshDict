/*--------------------------------*- C++ -*----------------------------------*\
| N2A Hybrid Wing-Body - PILOT MESH                                            |
|                                                                              |
| Deliberately coarse. Purpose is to validate the pipeline, not to produce a    |
| usable solution mesh:                                                         |
|   - does the STL snap cleanly to the leading edge and tail junctions          |
|   - does the locationInMesh sit in the right region                           |
|   - where does layer addition fail                                            |
|                                                                              |
| Surface level 7 -> 4 m / 128 = 31.2 mm.  5 layers, not 33.                    |
| Expect ~300 k cells, ~10 min.                                                  |
|                                                                              |
| Once this passes, scale to the production dict.                               |
\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    n2a_wt.stl
    {
        type triSurfaceMesh;
        name n2a;
        regions
        {
            "1_Wing_Body_S_Surf0"      { name wing_body_0;      }
            "2_Wing_Body_S_Surf1"      { name wing_body_1;      }
            "3_Vertical_Tails_S_Surf0" { name vertical_tails_0; }
            "4_Vertical_Tails_S_Surf1" { name vertical_tails_1; }
        }
    }

    // Near-field box around the aircraft
    refineNear
    {
        type searchableBox;
        min (-1.0 -0.2 -1.0);
        max ( 4.5  2.6  1.2);
    }

    // Wake box
    refineWake
    {
        type searchableBox;
        min ( 2.0 -0.2 -0.8);
        max (12.0  2.4  0.8);
    }

    // Outer box
    refineOuter
    {
        type searchableBox;
        min (-6.0 -0.5 -4.0);
        max (20.0  6.0  4.0);
    }
}

// ---------------------------------------------------------------------------
castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      6000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features
    (
        { file "n2a_wt.eMesh"; level 7; }
    );

    refinementSurfaces
    {
        n2a
        {
            level (6 7);
            patchInfo { type wall; }

            regions
            {
                wing_body_0      { level (6 7); patchInfo { type wall; } }
                wing_body_1      { level (6 7); patchInfo { type wall; } }
                vertical_tails_0 { level (8 9); patchInfo { type wall; } }
                vertical_tails_1 { level (8 9); patchInfo { type wall; } }
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        refineNear  { mode inside; levels ((1E15 5)); }
        refineWake  { mode inside; levels ((1E15 4)); }
        refineOuter { mode inside; levels ((1E15 2)); }
    }

    // Must be inside the fluid, outside the aircraft, and not on a face.
    // Well upstream and off-centre.
    locationInMesh (-20.137 15.211 8.309);

    allowFreeStandingZoneFaces true;
}

// ---------------------------------------------------------------------------
snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      50;
    nRelaxIter      5;

    // Feature edge snapping - important for the LE and tail junctions
    nFeatureSnapIter        10;
    implicitFeatureSnap     false;
    explicitFeatureSnap     true;
    multiRegionFeatureSnap  false;
}

// ---------------------------------------------------------------------------
addLayersControls
{
    relativeSizes       true;

    layers
    {
        "(wing_body|vertical_tails).*"
        {
            nSurfaceLayers 5;
        }
    }

    expansionRatio      1.2;
    finalLayerThickness 0.5;
    minThickness        0.05;

    nGrow               0;

    featureAngle        130;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.6;
    minMedialAxisAngle  130;
    nBufferCellsNoExtrude 0;
    nLayerIter          80;
    nRelaxedIter        50;
}

// ---------------------------------------------------------------------------
meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.02;
    minVolRatio         0.01;
    minTriangleTwist    -1;

    nSmoothScale        4;
    errorReduction      0.75;

    relaxed
    {
        maxNonOrtho     75;
    }
}

// ---------------------------------------------------------------------------
mergeTolerance 1e-6;

// ************************************************************************* //
