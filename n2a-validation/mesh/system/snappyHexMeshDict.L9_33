/*--------------------------------*- C++ -*----------------------------------*\
| N2A Hybrid Wing-Body - LEVEL 8 / 33 LAYER TEST                               |
|                                                                              |
| Tests whether the prism stack survives at production depth, at a cell count   |
| that fits comfortably on a laptop.                                            |
|                                                                              |
| Background cell 4 m:                                                          |
|   level 8 -> 15.6 mm surface cells                                            |
|   level 9 -> 7.8 mm   (production target, ~4.5 M cells)                       |
|                                                                              |
| Layers are ABSOLUTE, not relative:                                            |
|   firstLayerThickness 1.25e-5 m  -> y+ ~ 1 at Re = 6.6e6                      |
|   expansionRatio 1.2, 33 layers -> total 26.0 mm vs BL delta 24.6 mm          |
|   last layer 4.35 mm                                                          |
|                                                                              |
| Layer parameters carried from the pilot:                                      |
|   nGrow 0                (nGrow 1 collapsed coverage to 0.05%)                |
|   minMedialAxisAngle 130 (raised from 90: 73.9% -> 79.9%)                     |
|   maxThicknessToMedialRatio 0.6, nLayerIter 80, nRelaxedIter 50               |
|                                                                              |
| REMINDER: run blockMesh before every -overwrite run.                          |
\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    n2a_wt.stl
    {
        type triSurfaceMesh;
        name n2a;
        regions
        {
            "1_Wing_Body_S_Surf0"      { name wing_body_0;      }
            "2_Wing_Body_S_Surf1"      { name wing_body_1;      }
            "3_Vertical_Tails_S_Surf0" { name vertical_tails_0; }
            "4_Vertical_Tails_S_Surf1" { name vertical_tails_1; }
        }
    }

    refineNear
    {
        type searchableBox;
        min (-1.0 -0.2 -1.0);
        max ( 4.5  2.6  1.2);
    }

    refineWake
    {
        type searchableBox;
        min ( 2.0 -0.2 -0.8);
        max (12.0  2.4  0.8);
    }

    refineOuter
    {
        type searchableBox;
        min (-6.0 -0.5 -4.0);
        max (20.0  6.0  4.0);
    }
}

// ---------------------------------------------------------------------------
castellatedMeshControls
{
    maxLocalCells       4000000;
    maxGlobalCells      12000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features
    (
        { file "n2a_wt.eMesh"; level 9; }
    );

    refinementSurfaces
    {
        n2a
        {
            level (8 9);
            patchInfo { type wall; }

            regions
            {
                wing_body_0      { level (8 9); patchInfo { type wall; } }
                wing_body_1      { level (8 9); patchInfo { type wall; } }
                vertical_tails_0 { level (9 10); patchInfo { type wall; } }
                vertical_tails_1 { level (9 10); patchInfo { type wall; } }
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        refineNear  { mode inside; levels ((1E15 7)); }
        refineWake  { mode inside; levels ((1E15 6)); }
        refineOuter { mode inside; levels ((1E15 3)); }
    }

    locationInMesh (-20.137 15.211 8.309);

    allowFreeStandingZoneFaces true;
}

// ---------------------------------------------------------------------------
snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      50;
    nRelaxIter      5;

    nFeatureSnapIter        10;
    implicitFeatureSnap     false;
    explicitFeatureSnap     true;
    multiRegionFeatureSnap  false;
}

// ---------------------------------------------------------------------------
addLayersControls
{
    // ABSOLUTE sizing - thicknesses in metres, not fractions of cell size
    relativeSizes       false;

    layers
    {
        "(wing_body|vertical_tails).*"
        {
            nSurfaceLayers 33;
        }
    }

    firstLayerThickness 1.25e-5;      // y+ ~ 1
    expansionRatio      1.2;
    minThickness        1.25e-6;      // 10% of first layer

    nGrow               0;            // 1 collapses coverage on this geometry

    featureAngle        130;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.6;
    minMedialAxisAngle  130;
    nBufferCellsNoExtrude 0;
    nLayerIter          80;
    nRelaxedIter        50;
}

// ---------------------------------------------------------------------------
meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-16;        // relaxed: 12.5 micron cells are tiny
    minTetQuality       1e-20;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.02;
    minVolRatio         0.01;
    minTriangleTwist    -1;

    nSmoothScale        4;
    errorReduction      0.75;

    relaxed
    {
        maxNonOrtho     75;
    }
}

// ---------------------------------------------------------------------------
mergeTolerance 1e-6;

// ************************************************************************* //
