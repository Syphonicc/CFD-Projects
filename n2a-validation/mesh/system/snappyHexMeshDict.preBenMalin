/*--------------------------------*- C++ -*----------------------------------*\
| N2A Hybrid Wing-Body - WALL FUNCTION MESH                                     |
|                                                                               |
| Fallback from the wall-resolved requirement. Six attempts at y+ < 1 with a     |
| 12.5 micron first layer never exceeded 80% coverage and typically achieved     |
| only 1-3 of the requested layers; see notes/pilot_mesh_findings.md.            |
|                                                                               |
| Target here is y+ ~ 40, mid log-layer, where wall functions are valid.         |
|                                                                               |
|   y+ = 1  corresponds to 6.28 micron                                          |
|   y+ = 40 -> centroid at 251 micron -> first layer 0.5 mm                      |
|                                                                               |
|   10 layers, ratio 1.2, first 0.5 mm                                          |
|     total stack  12.98 mm                                                     |
|     last layer    2.58 mm                                                     |
|                                                                               |
| The first layer is 40x thicker than the wall-resolved attempt, which should    |
| put it well inside what medial-axis layer insertion can place.                 |
|                                                                               |
| Layer parameters carried from the pilot study:                                 |
|   nGrow 0                (nGrow 1 collapsed coverage to 0.05%)                 |
|   minMedialAxisAngle 130 (raised from 90: 73.9% -> 79.9%)                      |
|   maxThicknessToMedialRatio 0.6, nLayerIter 80, nRelaxedIter 50                |
|                                                                               |
| REMINDER: run blockMesh before every -overwrite run.                           |
\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    n2a_wt.stl
    {
        type triSurfaceMesh;
        name n2a;
    }

    refineNear
    {
        type searchableBox;
        min (-1.0 -0.2 -1.0);
        max ( 4.5  2.6  1.2);
    }

    refineWake
    {
        type searchableBox;
        min ( 2.0 -0.2 -0.8);
        max (12.0  2.4  0.8);
    }

    refineOuter
    {
        type searchableBox;
        min (-6.0 -0.5 -4.0);
        max (20.0  6.0  4.0);
    }
}

// ---------------------------------------------------------------------------
castellatedMeshControls
{
    maxLocalCells       4000000;
    maxGlobalCells      10000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features
    (
        { file "n2a_wt.eMesh"; level 8; }
    );

    refinementSurfaces
    {
        n2a
        {
            level (7 8);
            patchInfo { type wall; }

        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        refineNear  { mode inside; levels ((1E15 6)); }
        refineWake  { mode inside; levels ((1E15 5)); }
        refineOuter { mode inside; levels ((1E15 3)); }
    }

    locationInMesh (-20.137 15.211 8.309);

    allowFreeStandingZoneFaces true;
}

// ---------------------------------------------------------------------------
snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      50;
    nRelaxIter      5;

    nFeatureSnapIter        10;
    implicitFeatureSnap     false;
    explicitFeatureSnap     true;
    multiRegionFeatureSnap  false;
}

// ---------------------------------------------------------------------------
addLayersControls
{
    relativeSizes       false;      // absolute thicknesses, metres

    layers
    {
        "n2a.*"
        {
            nSurfaceLayers 10;
        }
    }

    firstLayerThickness 5.0e-4;     // y+ ~ 40
    expansionRatio      1.2;
    minThickness        5.0e-5;     // 10% of first layer

    nGrow               0;

    featureAngle        130;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.6;
    minMedialAxisAngle  130;
    nBufferCellsNoExtrude 0;
    nLayerIter          80;
    nRelaxedIter        50;
}

// ---------------------------------------------------------------------------
meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-14;
    minTetQuality       1e-18;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.02;
    minVolRatio         0.01;
    minTriangleTwist    -1;

    nSmoothScale        4;
    errorReduction      0.75;

    relaxed
    {
        maxNonOrtho     75;
    }
}

// ---------------------------------------------------------------------------
mergeTolerance 1e-6;

// ************************************************************************* //
