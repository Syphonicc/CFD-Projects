# OpenFOAM time directories
[0-9]*/
!0/
0.orig/

# Mesh (regenerable, large)
constant/polyMesh/
constant/extendedFeatureEdgeMesh/
constant/triSurface/*.eMesh

# Parallel decomposition
processor*/

# Logs
log.*
*.log

# Post-processing output
postProcessing/*/*/*.vtk
VTK/

# ParaView
*.foam
*.OpenFOAM

# Large geometry intermediates
geometry/*_raw.stl

# OS / editor
.DS_Store
*~
*.swp
*.bak
__pycache__/
*.pyc

# Generated mesh (regenerable from dictionaries)
**/constant/polyMesh/
**/constant/extendedFeatureEdgeMesh/
**/constant/triSurface/*.eMesh
**/constant/triSurface/*.stl

# Generated mesh (regenerable from dictionaries)
**/constant/polyMesh/
**/constant/extendedFeatureEdgeMesh/
**/constant/triSurface/*.eMesh
**/constant/triSurface/*.stl
**/constant/triSurface/*.fms
**/constant/triSurface/*.obj
**/constant/triSurface/*.vtp
**/cell_*.obj
**/constant/polyMesh.*/

# Case run artifacts
case_*/constant/polyMesh
case_*/postProcessing/
case_*/processor*/
case_*/log.*
*.bak
*.bak2

# Solution fields and raw samples (large, regenerable from cases + mesh)
results/*/OPENFOAM-solution/[0-9]*/
results/*/OPENFOAM-solution/constant/
results/*/OPENFOAM-solution/system/
results/*/*.tar.gz
analysis/*/*.raw
