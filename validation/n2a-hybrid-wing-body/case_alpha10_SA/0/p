FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 93290.0;

boundaryField
{
    inlet
    {
        type            freestreamPressure;
        freestreamValue uniform 93290.0;
    }
    outlet
    {
        type            freestreamPressure;
        freestreamValue uniform 93290.0;
    }
    farfield
    {
        type            freestreamPressure;
        freestreamValue uniform 93290.0;
    }
    symmetry
    {
        type            symmetry;
    }
    n2a
    {
        type            zeroGradient;
    }
}

