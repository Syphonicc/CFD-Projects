FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

// freestream nuTilda = 3 nu   (TMR convention)
internalField   uniform 4.758355e-05;

boundaryField
{
    inlet
    {
        type            freestream;
        freestreamValue uniform 4.758355e-05;
    }
    outlet
    {
        type            freestream;
        freestreamValue uniform 4.758355e-05;
    }
    farfield
    {
        type            freestream;
        freestreamValue uniform 4.758355e-05;
    }
    symmetry
    {
        type            symmetry;
    }
    n2a
    {
        type            fixedValue;
        value           uniform 0;
    }
}

